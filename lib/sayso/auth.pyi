"""Spotify OAuth: client credentials, authorization code with PKCE, token cache and config file."""

from collections.abc import Iterable, Mapping
from typing import Any

from .transport import TransportError as TransportError, post_form_json as post_form_json, query_string as query_string, unquote_plus as unquote_plus

TOKEN_URL: str
AUTHORIZE_URL: str

class SpotifyAuthError(Exception):
    """An OAuth request failed or was rejected."""

class TokenCache:
    """Stores access and refresh tokens in a JSON file."""

    path: str
    def __init__(self, path: str = 'tokens.json') -> None: ...
    def load(self) -> dict[str, Any]: ...
    def save(self, data: Mapping[str, Any]) -> bool: ...
    def load_auth(self, auth: AuthorizationCodeAuth) -> AuthorizationCodeAuth: ...
    def save_auth(self, auth: AuthorizationCodeAuth) -> bool: ...

class ClientCredentialsAuth:
    """App-only authorization (no user)."""

    client_id: str
    client_secret: str
    access_token: str | None
    expires_at: float
    def __init__(self, client_id: str, client_secret: str) -> None: ...
    def token(self) -> str: ...
    def refresh(self) -> str: ...

class AuthorizationCodeAuth:
    """User authorization with the authorization code flow, optionally with PKCE."""

    client_id: str
    client_secret: str
    redirect_uri: str
    scope: str | Iterable[str] | None
    refresh_token: str | None
    code_verifier: str | None
    token_cache: TokenCache | None
    access_token: str | None
    expires_at: float
    def __init__(self, client_id: str, client_secret: str, redirect_uri: str, scope: str | Iterable[str] | None = None, refresh_token: str | None = None, code_verifier: str | None = None, token_cache: TokenCache | None = None) -> None: ...
    def authorize_url(self, state: str | None = None, show_dialog: bool | None = None, code_challenge: str | None = None, code_challenge_method: str | None = None) -> str: ...
    def token(self) -> str: ...
    def exchange_code(self, code: str) -> str: ...
    def exchange_callback_url(self, callback_url: str, expected_state: str | None = None) -> str: ...
    def refresh(self) -> str: ...

def post_oauth_token(client_id: str, client_secret: str, data: Mapping[str, Any]) -> Any: ...
def oauth_error_from_transport(error: TransportError) -> SpotifyAuthError: ...
def authorization_url(client_id: str, redirect_uri: str, scope: str | Iterable[str] | None = None, state: str | None = None, show_dialog: bool | None = None, code_challenge: str | None = None, code_challenge_method: str | None = None) -> str: ...
def parse_callback_url(callback_url: str) -> dict[str, str]: ...
def generate_code_verifier(length: int = 64) -> str: ...
def code_challenge_s256(code_verifier: str) -> str: ...
def pkce_pair(length: int = 64) -> tuple[str, str]: ...
def random_bytes_for_verifier(length: int) -> bytes: ...
def base64_urlsafe(data: bytes) -> str: ...
def join_scope(scope: str | Iterable[str] | None) -> str | None: ...
def bool_string(value: object) -> str | None: ...
def add_query(query: dict[str, Any], key: str, value: Any) -> None: ...
def basic_token(client_id: str, client_secret: str) -> str: ...

DEFAULT_CONFIG_PATH: str
DEFAULT_TOKEN_CACHE_PATH: str
DEFAULT_REDIRECT_URI: str
USER_PROFILE_SCOPES: tuple[str, ...]
LIBRARY_READ_SCOPES: tuple[str, ...]
LIBRARY_WRITE_SCOPES: tuple[str, ...]
PLAYLIST_READ_SCOPES: tuple[str, ...]
PLAYLIST_WRITE_SCOPES: tuple[str, ...]
PLAYBACK_READ_SCOPES: tuple[str, ...]
PLAYBACK_WRITE_SCOPES: tuple[str, ...]
FOLLOW_WRITE_SCOPES: tuple[str, ...]
EXAMPLE_SCOPES: tuple[str, ...]

class SpotifyConfigError(SpotifyAuthError):
    """The config file is missing or incomplete."""

def load_config(path: str | None = None) -> dict[str, Any]: ...
def save_config(data: Mapping[str, Any], path: str | None = None) -> bool: ...
def config_available(path: str | None = None) -> bool: ...
def credentials_from_config(config: Mapping[str, Any]) -> tuple[str, str]: ...
def redirect_uri_from_config(config: Mapping[str, Any], cached: Mapping[str, Any] | None = None) -> str: ...
def scopes_from_config(config: Mapping[str, Any], cached: Mapping[str, Any] | None = None) -> list[str]: ...
def token_cache_from_config(config: Mapping[str, Any]) -> TokenCache: ...
def config_value(config: Mapping[str, Any], key: str, default: Any = None) -> Any: ...
def auth_from_config(config_path: str | None = None, scope: str | Iterable[str] | None = None, authenticate_if_needed: bool = True, auth_state: str = 'sayso') -> AuthorizationCodeAuth: ...
def authorize_with_local_server(auth: AuthorizationCodeAuth, redirect_uri: str, state: str = 'sayso', message: str = 'Spotify authorization received. You can close this window.', open_browser: bool = True) -> str: ...
def print_authorize_instructions(url: str, redirect_uri: str, open_browser: bool = True) -> None: ...
def try_open_browser(url: str) -> bool: ...
def wait_for_oauth_callback(host: str, port: int, message: str, redirect_uri: str) -> str: ...
def wait_for_oauth_callback_socket(host: str, port: int, message: str, redirect_uri: str) -> str: ...
def running_on_wsl() -> bool: ...
def redirect_uri_host_port(redirect_uri: str) -> tuple[str, int]: ...
