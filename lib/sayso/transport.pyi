"""HTTP and JSON helpers for the Spotify Web API, on top of whatever HTTP client the runtime has."""

from collections.abc import Mapping
from typing import Any

API_BASE_URL: str

class TransportError(Exception):
    """An HTTP request failed; `status` and `data` carry the response, `retry_after` the wait in seconds."""

    args: tuple[str]
    status: int | None
    data: Any
    retry_after: int | None
    def __init__(self, message: str, status: int | None = None, data: Any = None, retry_after: int | None = None) -> None: ...

requests: Any

def get_json(path_or_url: str, access_token: str | None = None, query: Mapping[str, Any] | None = None, headers: Mapping[str, str] | None = None, base_url: str = ...) -> Any: ...
def get_bytes(path_or_url: str, access_token: str | None = None, query: Mapping[str, Any] | None = None, headers: Mapping[str, str] | None = None, base_url: str = ...) -> bytes: ...
def post_form_json(url: str, data: Mapping[str, Any], headers: Mapping[str, str] | None = None) -> Any: ...
def post_json(path_or_url: str, data: Any = None, access_token: str | None = None, query: Mapping[str, Any] | None = None, headers: Mapping[str, str] | None = None, base_url: str = ...) -> Any: ...
def put_json(path_or_url: str, data: Any = None, access_token: str | None = None, query: Mapping[str, Any] | None = None, headers: Mapping[str, str] | None = None, base_url: str = ...) -> Any: ...
def delete_json(path_or_url: str, data: Any = None, access_token: str | None = None, query: Mapping[str, Any] | None = None, headers: Mapping[str, str] | None = None, base_url: str = ...) -> Any: ...
def put_body(path_or_url: str, body: str | bytes, content_type: str, access_token: str | None = None, query: Mapping[str, Any] | None = None, headers: Mapping[str, str] | None = None, base_url: str = ...) -> Any: ...
def request_json(method: str, path_or_url: str, data: Any = None, access_token: str | None = None, query: Mapping[str, Any] | None = None, headers: Mapping[str, str] | None = None, base_url: str = ...) -> Any: ...
def request_body(method: str, path_or_url: str, body: str | bytes, content_type: str, access_token: str | None = None, query: Mapping[str, Any] | None = None, headers: Mapping[str, str] | None = None, base_url: str = ...) -> Any: ...
def http_request(method: str, url: str, body: str | bytes | None, headers: dict[str, str]) -> Any: ...
def response_json(response: Any) -> Any: ...
def response_bytes(response: Any) -> bytes: ...
def response_status(response: Any) -> int | None: ...
def read_response_text(response: Any) -> str: ...
def read_response_bytes(response: Any) -> bytes: ...
def parse_response_json(response: Any, status: int | None = None) -> Any: ...
def close_connections() -> None: ...
def close_response(response: Any) -> None: ...
def json_loads(data: str | bytes) -> Any: ...
def json_dumps(data: Any) -> str: ...
def build_url(path_or_url: str, query: Mapping[str, Any] | None = None, base_url: str = ...) -> str: ...
def query_string(query: Mapping[str, Any] | None) -> str: ...
def quote(value: object) -> str: ...
def unquote_plus(value: str) -> str: ...
def simple_quote(value: str) -> str: ...
def simple_unquote(value: str) -> str: ...
