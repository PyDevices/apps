"""Optional same-interpreter adapter for an earful Connect device."""

from types import ModuleType
from typing import Any

class EarfulAdapter:
    """Wraps an earful device so a SpotifyClient can control it locally."""

    device: Any
    def __init__(self, device: Any) -> None: ...
    @property
    def device_id(self) -> str | None: ...
    @property
    def name(self) -> str | None: ...
    def play(self, context_uri: str | None = None, uris: list[str] | tuple[str, ...] | None = None, position_ms: int | None = None) -> Any: ...
    def pause(self) -> Any: ...
    def resume(self) -> Any: ...
    def next(self) -> Any: ...
    def previous(self) -> Any: ...
    def seek(self, position_ms: int) -> Any: ...
    def set_volume(self, volume_percent: int) -> None: ...
    def state(self) -> dict[str, Any]: ...

def discover(module: ModuleType | None = None) -> EarfulAdapter | None:
    """Return an adapter only when an application has exposed an earful device."""
