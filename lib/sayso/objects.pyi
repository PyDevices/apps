"""Spotify Web API objects: lazy, attribute-style views of the JSON the API returns."""

from collections.abc import Iterable, Iterator, Sequence
from typing import Any, Generic, TypeVar, overload

from .client import SpotifyClient
from .object_specs import SPOTIFY_OBJECT_SPECS as SPOTIFY_OBJECT_SPECS
from .transport import TransportError as TransportError

_T = TypeVar('_T')

class HydrationError(Exception):
    """An object could not be filled in from the API."""

    args: tuple[str]
    cause: TransportError | None
    def __init__(self, message: str, cause: TransportError | None = None) -> None: ...

def set_client(client: SpotifyClient | None) -> None: ...
def get_client() -> SpotifyClient | None: ...

class SpotifyObject:
    """Wraps one JSON object; a missing field is fetched from the API on first access."""

    def __init__(self, data: dict[str, Any] | None = None, **kwargs: Any) -> None: ...
    def raw(self) -> dict[str, Any]: ...

class Page(SpotifyObject, Generic[_T]):
    """A page of results; iterate it or index it to get items."""

    @property
    def items(self) -> Sequence[_T]: ...
    def __iter__(self) -> Iterator[_T]: ...
    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, index: int) -> _T: ...
    @overload
    def __getitem__(self, index: slice) -> Sequence[_T]: ...
    @property
    def href(self) -> str | None: ...
    @property
    def limit(self) -> int | None: ...
    @property
    def next(self) -> str | None: ...
    @property
    def offset(self) -> int | None: ...
    @property
    def previous(self) -> str | None: ...
    @property
    def total(self) -> int | None: ...

class LazyPageRef(SpotifyObject):
    """A page that is requested from the API when first iterated."""

    def __init__(self, owner: SpotifyObject, page_method: str, present_cls_name: str, ref_data: dict[str, Any] | None = None) -> None: ...
    def __iter__(self) -> Iterator[Any]: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> Any: ...
    @property
    def href(self) -> str | None: ...
    @property
    def total(self) -> int | None: ...

def make_spotify_class(spec: dict[str, Any]) -> type[SpotifyObject]: ...
def make_spotify_classes(specs: Iterable[dict[str, Any]]) -> dict[str, type[SpotifyObject]]: ...

class Paging(Page[_T]):
    ...

