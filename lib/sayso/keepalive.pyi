"""A small HTTP/1.1 client that keeps its TLS connections open."""

from typing import Any

class _NoLock:
    def acquire(self, *_a: Any) -> bool: ...
    def release(self) -> None: ...

TIMEOUT_S: int
SPLIT_BYTES: int
READ_CHUNK: int

class Response:
    """A finished response: status, lowercase header names, body bytes."""

    status_code: int
    headers: dict[str, str]
    content: bytes
    def __init__(self, status_code: int, headers: dict[str, str], content: bytes) -> None: ...
    @property
    def text(self) -> str: ...
    def json(self) -> Any: ...
    def close(self) -> None: ...

class _Conn:
    host: str
    port: int
    sock: Any
    used: int
    def __init__(self, host: str, port: int) -> None: ...
    def open(self) -> None: ...
    def close(self) -> None: ...

class _Reader:
    sock: Any
    def __init__(self, sock: Any) -> None: ...
    def line(self) -> bytes: ...
    def exact(self, n: int) -> bytes: ...
    def rest(self) -> bytes: ...

class Session:
    """Keeps one connection per host and reuses it until the server closes it."""

    def __init__(self) -> None: ...
    def close(self) -> None: ...
    def request(self, method: str, url: str, data: str | bytes | None = None, headers: dict[str, str] | None = None) -> Response: ...
    def get(self, url: str, headers: dict[str, str] | None = None) -> Response: ...
    def post(self, url: str, data: str | bytes | None = None, headers: dict[str, str] | None = None) -> Response: ...
    def put(self, url: str, data: str | bytes | None = None, headers: dict[str, str] | None = None) -> Response: ...
    def delete(self, url: str, data: str | bytes | None = None, headers: dict[str, str] | None = None) -> Response: ...
